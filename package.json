{
  "name": "f95_tracker",
  "version": "1.0.1",
  "description": "Windows desktop tracker for F95Zone game threads and local archives.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/sync-7zip.js",
    "test": "node test/run.js",
    "test:ui": "electron test/electronSmoke.js",
    "build": "electron-builder --win --publish never",
    "lint": "eslint ."
  },
  "keywords": [
    "electron",
    "f95zone",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.f95tracker.app",
    "productName": "F95 Tracker",
    "asar": true,
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fieze",
        "repo": "f95_tracker"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    }
  }
}
